+    // ---- NitroGen per-frame STATE EXPORT (env THEXTECH_STATE_EXPORT=<path>) -----------
+    // Writes the latest player state so the eval harness can annotate ground-truth game
+    // state (position, velocity, lives, death, menu) instead of guessing from pixels.
+    {
+        static FILE *s_ngState = nullptr;
+        static bool s_ngInit = false;
+        if(!s_ngInit)
+        {
+            s_ngInit = true;
+            const char *p = std::getenv("THEXTECH_STATE_EXPORT");
+            if(p && *p)
+                s_ngState = std::fopen(p, "w+");
+        }
+        if(s_ngState)
+        {
+            const Player_t &pl = Player[1];
+            std::rewind(s_ngState);
+            int n = std::fprintf(s_ngState,
+                "%.2f %.2f %.3f %.3f %d %d %d %d %d %d %d %d\n",
+                (double)pl.Location.X, (double)pl.Location.Y,
+                (double)pl.Location.SpeedX, (double)pl.Location.SpeedY,
+                (int)Lives, (int)pl.Dead, (int)GameMenu, (int)LevelSelect, (int)numPlayers,
+                (int)GamePaused, (int)EndLevel, (int)LevelBeatCode);
+            std::fflush(s_ngState);
+            if(n > 0)
+                (void)!ftruncate(fileno(s_ngState), (off_t)n);
+        }
+    }
+
     if(!GameIsActive)
         return;
 
